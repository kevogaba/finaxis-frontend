# Public application origin. No trailing slash.
# This environment's dev server runs on 3100 (see .env.local) because the
# platform's grafana-lgtm container holds port 3000 — 3000 is the portable
# canonical example for environments without that conflict.
BETTER_AUTH_URL=http://localhost:3000

# Generate with a cryptographically secure command such as:
# openssl rand -base64 48
BETTER_AUTH_SECRET=

# Reserved organisation that unlocks the platform-administration shell.
# Non-secret UUID from platform configuration. No trailing spaces.
PLATFORM_ORGANISATION_ID=

# Keycloak realm issuer, for example:
# https://identity.example.com/realms/finaxis
KEYCLOAK_ISSUER=

KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Comma-separated exact application origins where needed. No wildcards.
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Post-logout destination. Must belong to a trusted origin.
AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login

# Spring platform API origin. No trailing slash.
FINAXIS_API_URL=http://localhost:8080

# Redis connection string. Required in production only — it backs Better Auth's
# rate limiter with a shared store so counters survive across multiple app instances
# (the default in-memory store does not). Not needed in development/test: rate
# limiting is disabled outside production, so nothing here is read locally.
# Supports either Redis auth style, embedded directly in the URL:
#   - username + password (Redis 6+ ACLs): redis://default:password@host:6379
#   - password only (legacy `requirepass`):  redis://:password@host:6379
# Use `rediss://` instead of `redis://` if the Redis server requires TLS.
REDIS_URL=

# Namespaces every Redis key this app writes (e.g. finaxis-web:better-auth:ratelimit:<key>),
# so one Redis instance can safely be shared across multiple apps/environments without key
# collisions. The default below is fine for a dedicated Redis; override per environment
# (e.g. finaxis-web-prod, finaxis-web-staging) when sharing one Redis across several.
REDIS_KEY_PREFIX=finaxis-web
