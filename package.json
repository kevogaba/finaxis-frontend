{
  "name": "finaxis-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3100}",
    "build": "next build",
    "postbuild": "if [ -d public ]; then cp -r public .next/standalone/; fi && cp -r .next/static .next/standalone/.next/",
    "build:e2e": "FINAXIS_E2E_BUILD=1 next build && if [ -d public ]; then cp -r public .next-e2e/standalone/; fi && cp -r .next-e2e/static .next-e2e/standalone/.next-e2e/",
    "start": "node --env-file=.env.local .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build:e2e && playwright test",
    "test:e2e:ui": "pnpm build:e2e && playwright test --ui",
    "test:e2e:guard": "playwright test --config=playwright.guard.config.ts",
    "test:e2e:keycloak": "playwright test --config=playwright.keycloak.config.ts",
    "fake-api": "node e2e/fake-api/server.mts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run",
    "verify": "pnpm check && pnpm test:coverage && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "better-auth": "1.7.26",
    "ioredis": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@hookform/resolvers": "^7.0.7",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engines": {
    "node": ">=24.15.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
